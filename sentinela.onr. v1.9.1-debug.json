    linhaProximo.style.fontSize = '13px';
    linhaProximo.style.marginBottom = '14px';
    linhaProximo.style.color = '#93c5fd';

    const btnForcar = document.createElement('button');
    btnForcar.textContent = 'Forçar execução agora';
    btnForcar.style.background = '#2563eb';
    btnForcar.style.color = '#fff';
    btnForcar.style.border = 'none';
    btnForcar.style.padding = '9px 14px';
    btnForcar.style.width = '100%';
    btnForcar.style.borderRadius = '6px';
    btnForcar.style.cursor = 'pointer';
    btnForcar.style.fontSize = '13px';
    btnForcar.style.fontWeight = 'bold';
    btnForcar.style.marginBottom = '8px';

    const btnFecharPainel = document.createElement('button');
    btnFecharPainel.textContent = 'Fechar';
    btnFecharPainel.style.background = 'transparent';
    btnFecharPainel.style.color = '#aaa';
    btnFecharPainel.style.border = '1px solid #555';
    btnFecharPainel.style.padding = '7px 14px';
    btnFecharPainel.style.width = '100%';
    btnFecharPainel.style.borderRadius = '6px';
    btnFecharPainel.style.cursor = 'pointer';
