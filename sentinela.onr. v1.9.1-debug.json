// ==UserScript==
// @name         Sentinela ONR
// @namespace    guilherme.sentinela.onr
// @version      1.9.1-debug
// @author       Guilherme S. Costa
// @description  Automação desligada por padrão — ligue pelo painel flutuante (canto inferior direito). Ligada, a cada 2h, dentro do horário de expediente (8h-18h, seg-sex), pergunta se você quer iniciar a atualização de pedidos do ONR - E-Protocolo no Asgard. Se confirmar, clica sozinho em Importar Pedidos > Confirmar, aguarda você autenticar o certificado e segue direto pro próximo passo; depois de Atualizar Pedidos > Confirmar, pergunta se deu certo. O painel também mostra o último horário de cada passo e permite forçar a execução na hora. Não digita nem armazena nenhuma senha — a autenticação do certificado é sempre feita manualmente por você.
// v1.1: corrigido o seletor do menu lateral (usa o link real <a class="item-menu">, não o <div> que o envolve) e do ícone "Navegação" (por atributo title, não coordenadas fixas de tela).
// v1.2: popup inicial agora tem botão "Fechar" (X) além de "Sim, iniciar"/"Adiar" — fechar só dispensa, pergunta de novo no próximo ciclo normal (2h). Corrigida a busca do item "Importar Pedidos"/"Atualizar Pedidos" no menu ☰: agora procura em <a>, <li>, <span> e <div> (não só <button>), exige visibilidade real na tela, evita pegar elementos "container", e o clique sobe até o ancestral clicável e dispara mousedown/mouseup além do .click() (para componentes Vue que não respondem a clique sintético simples). O clique no ☰ para reabrir o dropdown só é repetido se o item realmente não for encontrado, evitando fechar um dropdown que já estava aberto.
// v1.3: confirmado via inspeção real do HTML do Asgard que os itens do menu ☰ (Importar Pedidos, Atualizar Pedidos etc.) são <button class="icon d-block p-1 text-left w-100 dropright pointer at-options at-bbottom">. Corrigida a comparação de texto para normalizar espaços/quebras de linha internas (o texto do botão no Vue pode vir com espaçamento extra ao redor do ícone) e adicionado um segundo modo de busca por "contém o texto" caso a igualdade exata falhe. Também passou a ignorar botões desabilitados (loading) na busca.
// v1.4: (1) notificação nativa do Chrome agora também dispara junto do popup de "Sim, iniciar/Adiar/Fechar", pra avisar mesmo se a aba do Asgard não estiver em foco. (2) Depois de autenticar o certificado, em vez de tentar detectar sozinho o fim da ação, o script pergunta "Foi importado/atualizado com sucesso?" (Sim/Não), com notificação nativa também, e um botão extra "Fechar aba". Só ao confirmar Sim é que conta o tempo pro próximo passo. (3) Botão flutuante fixo (canto inferior direito) que abre um painel de auditoria: horário da última importação e da última atualização (com sucesso/falha), e um botão "Forçar execução agora" que roda o ciclo completo na hora, ignorando o horário de expediente e o agendamento normal. Histórico salvo em localStorage, sobrevive a recarregar a página.
// v1.5: (1) removida a pergunta de confirmação do passo "Importar Pedidos" (intermediário) — agora só pergunta "deu certo?" no "Atualizar Pedidos" (passo final do ciclo); o Importar segue direto após dar tempo de autenticar. (2) Botão flutuante trocado para a imagem fornecida pelo usuário (embutida como ícone) e movido para o canto inferior direito. (3) Adicionado liga/desliga da automação dentro do painel — SEMPRE começa desligada em toda aba nova (não fica salvo/persistido de propósito); enquanto desligada, o script não pergunta nem agenda nada sozinho, só quando ligado manualmente pelo painel.
// v1.6: corrigido bug real detectado em teste — no "Importar Pedidos" a v1.5 parou de esperar/fechar o modal de resultado (ex: "Não há mais pedidos para importar"), que ficava aberto bloqueando a tela; quando o "Atualizar Pedidos" tentava rodar 2 min depois, falhava por baixo desse modal ainda aberto. Agora o Importar Pedidos continua sem PERGUNTAR se deu certo, mas espera e clica sozinho no botão "Fechar" desse modal antes de seguir — fechando a etapa direito antes de passar pro próximo passo.
// v1.7: no "Atualizar Pedidos" (passo final), depois de clicar em Confirmar, o script agora espera 10 minutos em silêncio (sem nenhum aviso na tela) antes de mostrar o popup "Foi concluído com sucesso?" — dá tempo real do Asgard processar e de você autenticar com calma. Só se aplica ao Atualizar Pedidos; o Importar Pedidos continua fechando o modal assim que ele aparecer, sem espera fixa.
// v1.8: o painel de auditoria agora mostra também "Próximo ciclo previsto" — o horário real do próximo agendamento (o mesmo setTimeout que o script já usa internamente, refletindo corretamente Adiar/Forçar/fora do expediente), não um cálculo aproximado. Como Importar e Atualizar Pedidos disparam juntos no mesmo ciclo, é uma linha só cobrindo os dois passos.
// v1.9: o script agora só inicializa (painel flutuante, popups, ciclo, tudo) se a página carregar já em .../app/v1/#/tarefas — em qualquer outra tela do Asgard, o script fica completamente inativo, sem aparecer nada. Só funciona se a URL já for #/tarefas no momento do carregamento da página; navegar internamente pra lá sem recarregar não ativa (precisa dar F5 na tela de tarefas).
// v1.9.1-debug: versão TEMPORÁRIA de diagnóstico do bug relatado ("desliga sozinho" após confirmar Atualizar Pedidos, sem clicar em Desligar). Não achei a causa só lendo o código, então esta versão loga no console (F12 > aba Console) toda mudança de automacaoAtiva (com stack trace de quem chamou), todo disparo de cicloDePergunta/agendarProximoCiclo, e quando a aba entra/sai de segundo plano. Também expõe __sentinelaOnrDebug() pra consultar o estado a qualquer momento. Assim que reproduzir o bug de novo, mande um print do console (aberto ANTES de começar o teste) pra eu achar a causa raiz exata e tirar essa versão de debug.
// @match        https://3rigoiania-go.sistemaasgard.com.br/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(function () {
  'use strict';

  // O script só deve funcionar na página de tarefas (onde o menu ONR - E-Protocolo
  // realmente existe). Se a página carregar em qualquer outra tela do Asgard, o
  // script não inicializa nada — nem popup, nem painel flutuante, nem notificação.
  // Só funciona se a URL já estiver em #/tarefas no momento do carregamento; navegar
  // internamente pra lá sem recarregar a página não ativa o script (precisa dar F5).
  if (!location.hash.includes('#/tarefas')) {
    return;
  }

  const NOME_SCRIPT = 'Sentinela ONR';

  // Automação começa sempre DESLIGADA em toda aba nova (não persiste entre aberturas
  // da página, de propósito — pra nunca rodar sozinha sem você ligar explicitamente
  // pelo painel de auditoria). Enquanto desligada, nenhum popup/notificação de ciclo
  // aparece — o script fica quieto até você ligar.
  // Só pra diagnosticar o bug relatado (painel mostrando "desligada" sem ninguém ter
  // clicado em Desligar). Toda MUDANÇA passa por definirAutomacaoAtiva(), que loga
  // quem chamou (com stack trace) no console (F12) — assim dá pra achar exatamente
  // o ponto que está desligando sozinho. window.__sentinelaOnrDebug() também pode ser
  // chamado a qualquer momento no console pra inspecionar o estado atual ao vivo.
  let automacaoAtiva = false;

  function definirAutomacaoAtiva(novoValor, origem) {
    if (novoValor !== automacaoAtiva) {
      console.warn(
        '[Sentinela ONR][DEBUG] automacaoAtiva mudou de ' + automacaoAtiva + ' para ' + novoValor +
          ' (origem: ' + origem + ', hora: ' + new Date().toLocaleTimeString('pt-BR') + '). Stack:',
        new Error().stack
      );
    }
    automacaoAtiva = novoValor;
  }

  window.__sentinelaOnrDebug = function () {
    console.log('[Sentinela ONR][DEBUG] automacaoAtiva =', automacaoAtiva,
      '| proximoCicloPrevistoEm =', typeof proximoCicloPrevistoEm !== 'undefined' && proximoCicloPrevistoEm
        ? new Date(proximoCicloPrevistoEm).toLocaleString('pt-BR')
        : proximoCicloPrevistoEm,
      '| timer ativo =', !!window.__sentinelaOnrTimer,
      '| document.hidden =', document.hidden,
      '| document.visibilityState =', document.visibilityState);
  };

  // --- Configurações ---
  const INTERVALO_CICLO_HORAS = 2;        // de quanto em quanto tempo perguntar
  const ADIAR_MINUTOS = 15;               // se clicar "Adiar", pergunta de novo depois disso
  const ESPERA_ENTRE_PASSOS_MINUTOS = 2;  // espera entre Importar e Atualizar
  const ESPERA_ANTES_DE_CONFIRMAR_MINUTOS = 10; // espera silenciosa após Confirmar no Atualizar Pedidos, antes do popup "deu certo?"
  const HORA_INICIO_EXPEDIENTE = 8;       // 8h
  const HORA_FIM_EXPEDIENTE = 18;         // 18h
  const DIAS_UTEIS = [1, 2, 3, 4, 5];     // seg(1) a sex(5); dom=0, sáb=6

  const URL_TAREFAS = 'https://3rigoiania-go.sistemaasgard.com.br/app/v1/#/tarefas';

  function log(msg) {
    console.log('[' + NOME_SCRIPT + '] ' + msg);
  }

  // ---------- Toast visual ----------

  function criarToastContainer() {
    let container = document.getElementById('__sentinela_onr_toast');
    if (container) return container;

    container = document.createElement('div');
    container.id = '__sentinela_onr_toast';
    container.style.position = 'fixed';
    container.style.top = '16px';
    container.style.right = '16px';
    container.style.zIndex = '2147483647';
    container.style.padding = '16px 22px';
    container.style.borderRadius = '8px';
    container.style.background = 'rgba(20, 40, 90, 0.95)';
    container.style.color = '#fff';
    container.style.fontFamily = 'Arial, sans-serif';
    container.style.fontSize = '16px';
    container.style.fontWeight = 'bold';
    container.style.boxShadow = '0 4px 14px rgba(0,0,0,0.35)';
    container.style.opacity = '0';
    container.style.transition = 'opacity 0.4s ease';
    container.style.pointerEvents = 'none';
    container.textContent = '';
    document.body.appendChild(container);
    return container;
  }

  function mostrarToast(mensagem, cor, duracaoMs) {
    const container = criarToastContainer();
    container.textContent = mensagem;
    container.style.background = cor || 'rgba(20, 40, 90, 0.95)';
    container.style.opacity = '1';

    clearTimeout(container.__hideTimer);
    container.__hideTimer = setTimeout(() => {
      container.style.opacity = '0';
    }, duracaoMs || 8000);
  }

  // ---------- Notificação nativa do Chrome ----------

  function pedirPermissaoNotificacao() {
    if (!('Notification' in window)) {
      log('Este navegador não suporta notificações nativas.');
      return;
    }
    if (Notification.permission === 'default') {
      Notification.requestPermission().then((perm) => {
        log('Permissão de notificação: ' + perm);
      });
    }
  }

  function enviarNotificacao(titulo, corpo, isErro) {
    if (!('Notification' in window)) return null;
    if (Notification.permission !== 'granted') {
      log('Sem permissão de notificação (status: ' + Notification.permission + ').');
      return null;
    }
    try {
      const notif = new Notification(titulo, {
        body: corpo,
        silent: !isErro,
        tag: 'sentinela-onr-' + Date.now(), // tag única: não substitui uma notificação anterior ainda não vista
        requireInteraction: true, // fica na tela até o usuário interagir, não some sozinha
      });
      // Clicar na notificação traz a aba do Asgard para frente.
      notif.onclick = () => {
        window.focus();
        notif.close();
      };
      return notif;
    } catch (e) {
      log('Falha ao criar notificação: ' + e.message);
      return null;
    }
  }

  // ---------- Histórico / auditoria (persistido em localStorage) ----------

  const CHAVE_HISTORICO = 'sentinela_onr_historico';

  function lerHistorico() {
    try {
      const bruto = localStorage.getItem(CHAVE_HISTORICO);
      return bruto ? JSON.parse(bruto) : {};
    } catch (e) {
      return {};
    }
  }

  function registrarHistorico(passo, sucesso) {
    try {
      const hist = lerHistorico();
      hist[passo] = { hora: new Date().toISOString(), sucesso: !!sucesso };
      localStorage.setItem(CHAVE_HISTORICO, JSON.stringify(hist));
    } catch (e) {
      log('Não foi possível salvar histórico: ' + e.message);
    }
  }

  function formatarHora(isoString) {
    if (!isoString) return 'nunca';
    const d = new Date(isoString);
    return d.toLocaleDateString('pt-BR') + ' às ' + d.toLocaleTimeString('pt-BR');
  }

  // ---------- Popup de pergunta (Iniciar / Adiar) ----------

  function criarPopupPergunta() {
    let overlay = document.getElementById('__sentinela_onr_popup');
    if (overlay) return overlay;

    overlay = document.createElement('div');
    overlay.id = '__sentinela_onr_popup';
    overlay.style.position = 'fixed';
    overlay.style.top = '0';
    overlay.style.left = '0';
    overlay.style.width = '100%';
    overlay.style.height = '100%';
    overlay.style.background = 'rgba(0,0,0,0.45)';
    overlay.style.zIndex = '2147483647';
    overlay.style.display = 'flex';
    overlay.style.alignItems = 'center';
    overlay.style.justifyContent = 'center';
    overlay.style.fontFamily = 'Arial, sans-serif';

    const box = document.createElement('div');
    box.style.background = '#182848';
    box.style.color = '#fff';
    box.style.padding = '28px 32px';
    box.style.borderRadius = '10px';
    box.style.boxShadow = '0 8px 30px rgba(0,0,0,0.5)';
    box.style.maxWidth = '360px';
    box.style.textAlign = 'center';

    box.style.position = 'relative';

    const btnFechar = document.createElement('button');
    btnFechar.textContent = '✕';
    btnFechar.title = 'Fechar';
    btnFechar.style.position = 'absolute';
    btnFechar.style.top = '10px';
    btnFechar.style.right = '12px';
    btnFechar.style.background = 'transparent';
    btnFechar.style.border = 'none';
    btnFechar.style.color = '#aaa';
    btnFechar.style.fontSize = '16px';
    btnFechar.style.cursor = 'pointer';
    btnFechar.style.lineHeight = '1';
    btnFechar.style.padding = '4px';

    const titulo = document.createElement('div');
    titulo.textContent = 'Sentinela ONR';
    titulo.style.fontSize = '18px';
    titulo.style.fontWeight = 'bold';
    titulo.style.marginBottom = '10px';

    const texto = document.createElement('div');
    texto.textContent = 'Hora de atualizar os pedidos do ONR - E-Protocolo. Iniciar agora?';
    texto.style.fontSize = '14px';
    texto.style.marginBottom = '20px';
    texto.style.lineHeight = '1.4';

    const botoes = document.createElement('div');
    botoes.style.display = 'flex';
    botoes.style.gap = '12px';
    botoes.style.justifyContent = 'center';

    const btnSim = document.createElement('button');
    btnSim.textContent = 'Sim, iniciar';
    btnSim.style.background = '#2563eb';
    btnSim.style.color = '#fff';
    btnSim.style.border = 'none';
    btnSim.style.padding = '10px 18px';
    btnSim.style.borderRadius = '6px';
    btnSim.style.cursor = 'pointer';
    btnSim.style.fontSize = '14px';
    btnSim.style.fontWeight = 'bold';

    const btnAdiar = document.createElement('button');
    btnAdiar.textContent = 'Adiar ' + ADIAR_MINUTOS + ' min';
    btnAdiar.style.background = 'transparent';
    btnAdiar.style.color = '#fff';
    btnAdiar.style.border = '1px solid #fff';
    btnAdiar.style.padding = '10px 18px';
    btnAdiar.style.borderRadius = '6px';
    btnAdiar.style.cursor = 'pointer';
    btnAdiar.style.fontSize = '14px';

    botoes.appendChild(btnSim);
    botoes.appendChild(btnAdiar);
    box.appendChild(btnFechar);
    box.appendChild(titulo);
    box.appendChild(texto);
    box.appendChild(botoes);
    overlay.appendChild(box);
    document.body.appendChild(overlay);

    overlay.__btnSim = btnSim;
    overlay.__btnAdiar = btnAdiar;
    overlay.__btnFechar = btnFechar;

    return overlay;
  }

  // Retorna 'sim', 'adiar' ou 'fechar' conforme o botão clicado.
  function perguntarSeQuerIniciar() {
    return new Promise((resolve) => {
      const overlay = criarPopupPergunta();
      overlay.style.display = 'flex';

      const limpar = () => {
        overlay.style.display = 'none';
        overlay.__btnSim.onclick = null;
        overlay.__btnAdiar.onclick = null;
        overlay.__btnFechar.onclick = null;
      };

      overlay.__btnSim.onclick = () => {
        limpar();
        resolve('sim');
      };
      overlay.__btnAdiar.onclick = () => {
        limpar();
        resolve('adiar');
      };
      overlay.__btnFechar.onclick = () => {
        limpar();
        resolve('fechar');
      };
    });
  }

  // ---------- Popup de confirmação pós-autenticação (Sim / Não / Fechar aba) ----------

  function criarPopupConfirmacao() {
    let overlay = document.getElementById('__sentinela_onr_popup_confirma');
    if (overlay) return overlay;

    overlay = document.createElement('div');
    overlay.id = '__sentinela_onr_popup_confirma';
    overlay.style.position = 'fixed';
    overlay.style.top = '0';
    overlay.style.left = '0';
    overlay.style.width = '100%';
    overlay.style.height = '100%';
    overlay.style.background = 'rgba(0,0,0,0.45)';
    overlay.style.zIndex = '2147483647';
    overlay.style.display = 'none';
    overlay.style.alignItems = 'center';
    overlay.style.justifyContent = 'center';
    overlay.style.fontFamily = 'Arial, sans-serif';

    const box = document.createElement('div');
    box.style.background = '#182848';
    box.style.color = '#fff';
    box.style.padding = '28px 32px';
    box.style.borderRadius = '10px';
    box.style.boxShadow = '0 8px 30px rgba(0,0,0,0.5)';
    box.style.maxWidth = '380px';
    box.style.textAlign = 'center';

    const titulo = document.createElement('div');
    titulo.textContent = 'Sentinela ONR';
    titulo.style.fontSize = '18px';
    titulo.style.fontWeight = 'bold';
    titulo.style.marginBottom = '10px';

    const texto = document.createElement('div');
    texto.className = '__sentinela_onr_texto_confirma';
    texto.style.fontSize = '14px';
    texto.style.marginBottom = '20px';
    texto.style.lineHeight = '1.4';

    const botoes = document.createElement('div');
    botoes.style.display = 'flex';
    botoes.style.flexWrap = 'wrap';
    botoes.style.gap = '10px';
    botoes.style.justifyContent = 'center';

    const btnSim = document.createElement('button');
    btnSim.textContent = 'Sim, deu certo';
    btnSim.style.background = '#16a34a';
    btnSim.style.color = '#fff';
    btnSim.style.border = 'none';
    btnSim.style.padding = '10px 16px';
    btnSim.style.borderRadius = '6px';
    btnSim.style.cursor = 'pointer';
    btnSim.style.fontSize = '14px';
    btnSim.style.fontWeight = 'bold';

    const btnNao = document.createElement('button');
    btnNao.textContent = 'Não, deu problema';
    btnNao.style.background = '#dc2626';
    btnNao.style.color = '#fff';
    btnNao.style.border = 'none';
    btnNao.style.padding = '10px 16px';
    btnNao.style.borderRadius = '6px';
    btnNao.style.cursor = 'pointer';
    btnNao.style.fontSize = '14px';
    btnNao.style.fontWeight = 'bold';

    const btnFecharAba = document.createElement('button');
    btnFecharAba.textContent = 'Sim e fechar aba';
    btnFecharAba.style.background = 'transparent';
    btnFecharAba.style.color = '#fff';
    btnFecharAba.style.border = '1px solid #fff';
    btnFecharAba.style.padding = '10px 16px';
    btnFecharAba.style.borderRadius = '6px';
    btnFecharAba.style.cursor = 'pointer';
    btnFecharAba.style.fontSize = '14px';

    botoes.appendChild(btnSim);
    botoes.appendChild(btnFecharAba);
    botoes.appendChild(btnNao);
    box.appendChild(titulo);
    box.appendChild(texto);
    box.appendChild(botoes);
    overlay.appendChild(box);
    document.body.appendChild(overlay);

    overlay.__texto = texto;
    overlay.__btnSim = btnSim;
    overlay.__btnNao = btnNao;
    overlay.__btnFecharAba = btnFecharAba;

    return overlay;
  }

  // Pergunta se o passo (Importar/Atualizar) deu certo. Retorna 'sim', 'sim-fechar-aba' ou 'nao'.
  function perguntarSeDeuCerto(nomeBotaoMenu) {
    return new Promise((resolve) => {
      const overlay = criarPopupConfirmacao();
      overlay.__texto.textContent = 'Você autenticou o certificado para "' + nomeBotaoMenu + '". Foi concluído com sucesso?';
      overlay.style.display = 'flex';

      const limpar = () => {
        overlay.style.display = 'none';
        overlay.__btnSim.onclick = null;
        overlay.__btnNao.onclick = null;
        overlay.__btnFecharAba.onclick = null;
      };

      overlay.__btnSim.onclick = () => {
        limpar();
        resolve('sim');
      };
      overlay.__btnFecharAba.onclick = () => {
        limpar();
        resolve('sim-fechar-aba');
      };
      overlay.__btnNao.onclick = () => {
        limpar();
        resolve('nao');
      };
    });
  }

  // ---------- Painel flutuante de auditoria ----------

  // Ícone do botão flutuante (imagem fornecida pelo usuário, redimensionada para 64x64
  // e embutida como data URI, pra não depender de nenhum arquivo externo).
  const ICONE_FAB_DATA_URI = 'data:image/png;base64,';

  function criarBotaoFlutuante() {
    let btn = document.getElementById('__sentinela_onr_fab');
    if (btn) return btn;

    btn = document.createElement('button');
    btn.id = '__sentinela_onr_fab';
    btn.title = 'Sentinela ONR — auditoria';
    btn.style.position = 'fixed';
    btn.style.bottom = '16px';
    btn.style.right = '16px';
    btn.style.zIndex = '2147483646';
    btn.style.width = '48px';
    btn.style.height = '48px';
    btn.style.borderRadius = '50%';
    btn.style.border = 'none';
    btn.style.padding = '0';
    btn.style.overflow = 'hidden';
    btn.style.background = 'rgba(20, 40, 90, 0.95)';
    btn.style.cursor = 'pointer';
    btn.style.boxShadow = '0 2px 10px rgba(0,0,0,0.4)';

    const img = document.createElement('img');
    img.src = ICONE_FAB_DATA_URI;
    img.style.width = '100%';
    img.style.height = '100%';
    img.style.objectFit = 'cover';
    img.style.display = 'block';
    btn.appendChild(img);

    document.body.appendChild(btn);
    return btn;
  }

  function criarPainelAuditoria() {
    let painel = document.getElementById('__sentinela_onr_painel');
    if (painel) return painel;

    painel = document.createElement('div');
    painel.id = '__sentinela_onr_painel';
    painel.style.position = 'fixed';
    painel.style.bottom = '72px';
    painel.style.right = '16px';
    painel.style.zIndex = '2147483646';
    painel.style.background = '#182848';
    painel.style.color = '#fff';
    painel.style.fontFamily = 'Arial, sans-serif';
    painel.style.padding = '18px 20px';
    painel.style.borderRadius = '10px';
    painel.style.boxShadow = '0 8px 30px rgba(0,0,0,0.5)';
    painel.style.minWidth = '270px';
    painel.style.display = 'none';

