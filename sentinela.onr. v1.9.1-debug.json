    btnToggle.style.cursor = 'pointer';
    btnToggle.style.fontSize = '12px';
    btnToggle.style.fontWeight = 'bold';

    linhaToggle.appendChild(labelToggle);
    linhaToggle.appendChild(btnToggle);

