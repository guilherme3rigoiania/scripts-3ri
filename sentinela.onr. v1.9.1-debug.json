    painel.appendChild(linhaImportar);
    painel.appendChild(linhaAtualizar);
    painel.appendChild(linhaProximo);
    painel.appendChild(btnForcar);
    painel.appendChild(btnFecharPainel);
    document.body.appendChild(painel);

    painel.__labelToggle = labelToggle;
    painel.__btnToggle = btnToggle;
    painel.__linhaImportar = linhaImportar;
    painel.__linhaAtualizar = linhaAtualizar;
    painel.__linhaProximo = linhaProximo;
    painel.__btnForcar = btnForcar;
    painel.__btnFecharPainel = btnFecharPainel;

    return painel;
  }

  function atualizarPainelAuditoria() {
    const painel = document.getElementById('__sentinela_onr_painel');
    if (!painel) return;
    const hist = lerHistorico();

    function textoLinha(nome, entrada) {
      if (!entrada) return nome + ': nunca executado.';
      const status = entrada.sucesso ? '✅ sucesso' : '⚠️ falhou';
      return nome + ': ' + formatarHora(entrada.hora) + ' (' + status + ')';
    }

    painel.__linhaImportar.textContent = textoLinha('Importar Pedidos', hist['Importar Pedidos']);
    painel.__linhaAtualizar.textContent = textoLinha('Atualizar Pedidos', hist['Atualizar Pedidos']);

    // Próximo ciclo previsto (Importar + Atualizar disparam juntos, no mesmo evento
    // agendado — não faz sentido horários separados pros dois).
    if (!automacaoAtiva) {
      painel.__linhaProximo.textContent = 'Próximo ciclo: automação desligada.';
    } else if (proximoCicloPrevistoEm) {
      painel.__linhaProximo.textContent = 'Próximo ciclo previsto: ' + formatarHora(new Date(proximoCicloPrevistoEm).toISOString());
    } else {
      painel.__linhaProximo.textContent = 'Próximo ciclo: em andamento agora.';
    }

    if (automacaoAtiva) {
      painel.__labelToggle.textContent = 'Automação: ligada';
      painel.__btnToggle.textContent = 'Desligar';
      painel.__btnToggle.style.background = '#dc2626';
      painel.__btnToggle.style.color = '#fff';
    } else {
      painel.__labelToggle.textContent = 'Automação: desligada';
      painel.__btnToggle.textContent = 'Ligar';
      painel.__btnToggle.style.background = '#16a34a';
      painel.__btnToggle.style.color = '#fff';
    }
  }

  function inicializarPainelAuditoria(aoForcar, aoAlternarAutomacao) {
    const fab = criarBotaoFlutuante();
    const painel = criarPainelAuditoria();

    fab.onclick = () => {
      atualizarPainelAuditoria();
      painel.style.display = painel.style.display === 'none' ? 'block' : 'none';
    };

    painel.__btnFecharPainel.onclick = () => {
      painel.style.display = 'none';
    };

    painel.__btnToggle.onclick = () => {
      aoAlternarAutomacao();
      atualizarPainelAuditoria();
    };

    painel.__btnForcar.onclick = () => {
      painel.style.display = 'none';
      aoForcar();
    };
  }

  // ---------- Utilidades de espera ----------

  function esperar(ms) {
    return new Promise((resolve) => setTimeout(resolve, ms));
  }

  // Reduz o texto de um elemento a uma forma comparável: junta espaços/quebras de
  // linha internas (comuns em templates Vue, ex: "\n  Importar Pedidos\n") em um
  // espaço só, e tira espaços nas pontas. Também remove caracteres de ícone comuns
  // que às vezes entram no textContent (ex: glifos de fontes de ícone).
  function normalizarTexto(s) {
    return (s || '').replace(/\s+/g, ' ').trim();
  }

  // Espera até um elemento clicável (por texto) aparecer VISÍVEL na página, checando
  // periodicamente. Itens de menu/dropdown nem sempre são <button> — podem ser <a>,
  // <li>, <span> ou <div> (no Asgard, os itens do menu ☰ são <button class="icon ...">
  // com um ícone + texto dentro) — então checamos vários tipos de elemento clicável,
  // comparamos o texto normalizado (ignorando espaços/quebras extras), e exigimos que
  // esteja realmente visível (largura/altura > 0) e não desabilitado.
  function esperarBotaoPorTexto(texto, timeoutMs) {
    const alvoNormalizado = normalizarTexto(texto);
    return new Promise((resolve) => {
      const inicio = Date.now();
      const intervalo = setInterval(() => {
        const candidatos = Array.from(document.querySelectorAll('button, a, li, span, div'));
        // Primeiro tenta achar uma correspondência exata (mais segura); se não achar
        // nenhuma, tenta uma correspondência "contém o texto", pro caso do elemento
        // ter algum caractere extra (ícone) grudado no texto.
        function candidatoValido(el, comparar) {
          if (!comparar(normalizarTexto(el.textContent))) return false;
          if (el.matches && el.matches('[disabled], .disabled')) return false;
          if (el.closest && el.closest('[disabled]')) return false;
          const rect = el.getBoundingClientRect();
          if (!(rect.width > 0 && rect.height > 0)) return false;
          // Evita pegar um elemento "container" cujo textContent bate só porque
          // contém outro elemento com esse texto dentro (queremos o nó mais específico).
          if (el.children.length > 0) {
            const filhoIgual = Array.from(el.children).some((c) => comparar(normalizarTexto(c.textContent)));
            if (filhoIgual) return false;
          }
          return true;
        }

        let alvo = candidatos.find((el) => candidatoValido(el, (t) => t === alvoNormalizado));
        if (!alvo) {
          alvo = candidatos.find((el) => candidatoValido(el, (t) => t.includes(alvoNormalizado)));
        }

        if (alvo) {
          clearInterval(intervalo);
          resolve(alvo);
        } else if (Date.now() - inicio > timeoutMs) {
          clearInterval(intervalo);
          resolve(null);
        }
      }, 300);
    });
  }

  function clicar(el) {
    if (!el) return;
    // Se o elemento não é naturalmente clicável (ex: um <span> ou <div> de texto dentro
    // de um <a>/<li> com o handler real), sobe até achar um ancestral que faça sentido
    // clicar — mas sem passar de 3 níveis, pra não acabar clicando em algo grande demais.
    let alvo = el;
    if (!['A', 'BUTTON', 'LI'].includes(alvo.tagName)) {
      const ancestral = alvo.closest('a, button, li');
      if (ancestral) alvo = ancestral;
    }
    alvo.click();
    // Alguns componentes Vue (ex: dropdowns baseados em @mousedown em vez de @click)
    // não respondem a .click() sintético; dispara mousedown/mouseup também por garantia.
    try {
      const opts = { bubbles: true, cancelable: true, view: window };
      alvo.dispatchEvent(new MouseEvent('mousedown', opts));
      alvo.dispatchEvent(new MouseEvent('mouseup', opts));
    } catch (e) {
      // silencioso — o .click() acima já foi tentado.
    }
  }

  // ---------- Verificação de horário de expediente ----------

  function dentroDoExpediente() {
    const agora = new Date();
    const dia = agora.getDay();
    const hora = agora.getHours();
    return DIAS_UTEIS.includes(dia) && hora >= HORA_INICIO_EXPEDIENTE && hora < HORA_FIM_EXPEDIENTE;
  }

  // ---------- Fluxo principal de um passo (Importar OU Atualizar) ----------

  // Se pedirConfirmacao for false, o script não pergunta se deu certo — assume sucesso
  // depois de clicar em Confirmar e segue direto (usado no "Importar Pedidos", que é
  // um passo intermediário). Se for true, mostra o popup de confirmação Sim/Não (usado
  // só no "Atualizar Pedidos", o passo final do ciclo).
  async function executarPasso(nomeBotaoMenu, pedirConfirmacao) {
    log('Iniciando passo: ' + nomeBotaoMenu);

    // Garante que estamos na tela de tarefas, onde o menu ONR - E-Protocolo é aberto.
    if (!location.href.includes('#/tarefas')) {
      location.href = URL_TAREFAS;
      await esperar(3000);
    }

    // Função auxiliar: acha o botão "Ver Ações" (☰) do modal ONR - E-Protocolo,
    // usado tanto para checar se o modal já está aberto quanto depois de abri-lo.
    function acharBotaoVerAcoes() {
      const el = document.querySelector('[title="Ver Ações"]');
      if (!el) return null;
      return el.getBoundingClientRect().width > 0 ? el : null;
    }

    // Se o modal já estiver aberto (de uma execução anterior recente), não precisa
    // reabrir o menu lateral nem clicar em nada — já pode seguir direto pro ☰.
    if (!acharBotaoVerAcoes()) {
      // O link real e clicável é um <a class="item-menu">, não o <div> que o envolve
      // (o <div> pai também bate no textContent, mas clicar nele não faz nada).
      const linkMenuLateral = Array.from(document.querySelectorAll('a.item-menu')).find(
        (el) => el.textContent.trim() === 'ONR - E-Protocolo'
      );

      let linkAlvo = linkMenuLateral;

      // Se não achou, o painel de navegação lateral pode estar colapsado — expande
      // clicando no ícone "Navegação" (identificado pelo atributo title, não por
      // coordenadas fixas de tela, que variam conforme os banners de aviso no topo).
      if (!linkAlvo) {
        const iconeNavegacao = document.querySelector('a[title="Navegação"]');
        if (iconeNavegacao) {
          clicar(iconeNavegacao);
          await esperar(800);
        }
        linkAlvo = Array.from(document.querySelectorAll('a.item-menu')).find(
          (el) => el.textContent.trim() === 'ONR - E-Protocolo'
        );
      }

      if (!linkAlvo) {
        mostrarToast(
          NOME_SCRIPT + ': não encontrei o menu automaticamente. Abra "ONR - E-Protocolo" manualmente.',
          'rgba(150, 30, 30, 0.95)',
          10000
        );
        return false;
      }

      clicar(linkAlvo);

      // Aguarda o modal "ONR - E-Protocolo" realmente aparecer (via o botão ☰ dele)
      // antes de seguir.
      const inicioEsperaModal = Date.now();
      while (!acharBotaoVerAcoes() && Date.now() - inicioEsperaModal < 6000) {
        await esperar(300);
      }

      if (!acharBotaoVerAcoes()) {
        mostrarToast(
          NOME_SCRIPT + ': cliquei no menu, mas o modal "ONR - E-Protocolo" não abriu. Verifique manualmente.',
          'rgba(150, 30, 30, 0.95)',
          10000
        );
        return false;
      }
    }

    await esperar(500);

    // Clica no botão "Ver Ações" (ícone ☰ do modal), já validado acima como presente,
    // para abrir o dropdown com "Importar Pedidos" / "Atualizar Pedidos".
    const btnVerAcoes = acharBotaoVerAcoes();
    if (!btnVerAcoes) {
      mostrarToast(NOME_SCRIPT + ': não encontrei o menu de ações (☰). Verifique manualmente.', 'rgba(150, 30, 30, 0.95)', 10000);
      return false;
    }
    clicar(btnVerAcoes);
    await esperar(700);

    // Procura o item do dropdown. Se não achar de primeira, o dropdown pode ter
    // fechado sozinho (perda de foco) ou o clique no ☰ não abriu — então tentamos
    // reabrir com um novo clique no ☰, mas só se o item continuar ausente, pra não
    // arriscar fechar um dropdown que já esteja aberto (☰ costuma alternar aberto/fechado).
    let btnAcao = await esperarBotaoPorTexto(nomeBotaoMenu, 3500);
    if (!btnAcao) {
      const btnVerAcoes2 = acharBotaoVerAcoes();
      if (btnVerAcoes2) {
        clicar(btnVerAcoes2);
        await esperar(700);
        btnAcao = await esperarBotaoPorTexto(nomeBotaoMenu, 4500);
      }
    }

    if (!btnAcao) {
      mostrarToast(NOME_SCRIPT + ': não encontrei "' + nomeBotaoMenu + '". Verifique manualmente.', 'rgba(150, 30, 30, 0.95)', 10000);
      registrarHistorico(nomeBotaoMenu, false);
      return { sucesso: false, fecharAba: false };
    }
    clicar(btnAcao);
    await esperar(600);

    // Se aparecer a confirmação "Você tem certeza?", clica em Confirmar.
    const btnConfirmar = await esperarBotaoPorTexto('Confirmar', 3000);
    if (btnConfirmar) {
      clicar(btnConfirmar);
    }

    // A partir daqui, o Asgard/certificado deve pedir autenticação.
    mostrarToast(
      NOME_SCRIPT + ': autentique o certificado para "' + nomeBotaoMenu + '"...',
      'rgba(150, 110, 20, 0.95)',
      10000
    );
    enviarNotificacao(
      NOME_SCRIPT,
      'Autentique o certificado para "' + nomeBotaoMenu + '" na aba do Asgard.',
      false
    );

    // Só o passo final do ciclo (Atualizar Pedidos) pergunta se deu certo. O passo
    // intermediário (Importar Pedidos) NÃO pergunta, mas ainda precisa fechar sozinho
    // o modal de resultado (ex: "Não há mais pedidos para importar") antes de seguir —
    // senão esse modal fica aberto bloqueando a tela e o próximo passo (Atualizar
    // Pedidos) falha ao tentar rodar por baixo dele.
    if (!pedirConfirmacao) {
      const btnFecharResultado = await esperarBotaoPorTexto('Fechar', 120000); // até 2 min esperando você autenticar
      if (btnFecharResultado) {
        clicar(btnFecharResultado);
        await esperar(400);
        registrarHistorico(nomeBotaoMenu, true);
        mostrarToast(NOME_SCRIPT + ': "' + nomeBotaoMenu + '" enviado.', 'rgba(20, 110, 60, 0.95)', 8000);
        return { sucesso: true, fecharAba: false };
      } else {
        registrarHistorico(nomeBotaoMenu, false);
        mostrarToast(
          NOME_SCRIPT + ': não detectei a conclusão de "' + nomeBotaoMenu + '". Verifique a tela manualmente antes do próximo passo.',
          'rgba(150, 30, 30, 0.95)',
          10000
        );
        return { sucesso: false, fecharAba: false };
      }
    }

    // No passo final (Atualizar Pedidos), espera 10 min em silêncio (sem toast/aviso
    // nenhum) antes de mostrar o popup de confirmação — dá tempo real do Asgard
    // processar e de você autenticar com calma, sem pressa.
    await esperar(ESPERA_ANTES_DE_CONFIRMAR_MINUTOS * 60 * 1000);

    const resposta = await perguntarSeDeuCerto(nomeBotaoMenu);
    const sucesso = resposta === 'sim' || resposta === 'sim-fechar-aba';
    const fecharAba = resposta === 'sim-fechar-aba';

    registrarHistorico(nomeBotaoMenu, sucesso);

    if (sucesso) {
      mostrarToast(NOME_SCRIPT + ': "' + nomeBotaoMenu + '" concluído.', 'rgba(20, 110, 60, 0.95)', 8000);
    } else {
      mostrarToast(
        NOME_SCRIPT + ': "' + nomeBotaoMenu + '" marcado como não concluído. Verifique manualmente.',
        'rgba(150, 30, 30, 0.95)',
        10000
      );
    }

    return { sucesso, fecharAba };
  }

  async function executarCicloCompleto() {
    log('Ciclo completo iniciado.');
    const resultadoImportar = await executarPasso('Importar Pedidos', false);
    if (resultadoImportar.fecharAba) {
      window.close();
      return;
    }
    if (!resultadoImportar.sucesso) return;

    mostrarToast(NOME_SCRIPT + ': aguardando ' + ESPERA_ENTRE_PASSOS_MINUTOS + ' min antes de atualizar...', null, 6000);
    await esperar(ESPERA_ENTRE_PASSOS_MINUTOS * 60 * 1000);

    const resultadoAtualizar = await executarPasso('Atualizar Pedidos', true);
    if (resultadoAtualizar.fecharAba) {
      window.close();
      return;
    }
    if (resultadoAtualizar.sucesso) {
      const hora = new Date().toLocaleTimeString('pt-BR');
      mostrarToast(NOME_SCRIPT + ': atualização de pedidos concluída às ' + hora + '.', 'rgba(20, 110, 60, 0.95)', 10000);
      enviarNotificacao(NOME_SCRIPT, 'Atualização de pedidos concluída às ' + hora + '.', false);
    }
  }

  async function cicloDePergunta() {
    console.log('[Sentinela ONR][DEBUG] cicloDePergunta disparou às ' + new Date().toLocaleTimeString('pt-BR') + '. automacaoAtiva =', automacaoAtiva, '| document.hidden =', document.hidden);
    // Automação desligada: fica quieto, não pergunta nada, não agenda o próximo ciclo
    // sozinho. Só volta a rodar quando você ligar pelo painel de auditoria.
    if (!automacaoAtiva) {
      log('Automação desligada — ciclo não executado.');
      return;
    }

    if (!dentroDoExpediente()) {
      log('Fora do horário de expediente. Aguardando próximo ciclo.');
      agendarProximoCiclo(INTERVALO_CICLO_HORAS * 60 * 60 * 1000);
      return;
    }

    // O timer que disparou este ciclo já foi consumido — não há mais nada agendado
    // até decidirmos o próximo passo (popup, ciclo completo etc.).
    proximoCicloPrevistoEm = null;

    // Notificação nativa junto do popup, pra avisar mesmo se a aba não estiver em foco.
    enviarNotificacao(
      NOME_SCRIPT,
      'Hora de atualizar os pedidos do ONR - E-Protocolo. Veja a aba do Asgard para iniciar.',
      false
    );

    const resposta = await perguntarSeQuerIniciar();
    if (resposta === 'sim') {
      await executarCicloCompleto();
      agendarProximoCiclo(INTERVALO_CICLO_HORAS * 60 * 60 * 1000);
    } else if (resposta === 'adiar') {
      log('Adiado por ' + ADIAR_MINUTOS + ' min.');
      mostrarToast(NOME_SCRIPT + ': ok, pergunto de novo em ' + ADIAR_MINUTOS + ' min.', null, 6000);
      agendarProximoCiclo(ADIAR_MINUTOS * 60 * 1000);
    } else {
      // 'fechar': dispensa sem decidir — só volta a perguntar no próximo ciclo normal (2h).
      log('Fechado sem decidir. Próxima pergunta no ciclo normal.');
      agendarProximoCiclo(INTERVALO_CICLO_HORAS * 60 * 60 * 1000);
    }
  }

  // Guarda quando o próximo ciclo está realmente agendado para acontecer (timestamp),
  // pra poder mostrar isso no painel de auditoria. null = nada agendado no momento
  // (automação desligada, ou rodando um ciclo agora).
  let proximoCicloPrevistoEm = null;

  function agendarProximoCiclo(delayMs) {
    console.log('[Sentinela ONR][DEBUG] agendarProximoCiclo(' + delayMs + 'ms) chamado. automacaoAtiva =', automacaoAtiva, '. Stack:', new Error().stack);
    clearTimeout(window.__sentinelaOnrTimer);
    if (!automacaoAtiva) {
      proximoCicloPrevistoEm = null;
      return;
    }
    proximoCicloPrevistoEm = Date.now() + delayMs;
    window.__sentinelaOnrTimer = setTimeout(cicloDePergunta, delayMs);
  }

  // Liga/desliga a automação a partir do painel. Ao ligar, começa o primeiro ciclo em
  // 30s (dando tempo da tela estabilizar) e passa a agendar normalmente. Ao desligar,
  // cancela qualquer ciclo agendado na hora.
  function alternarAutomacao() {
    definirAutomacaoAtiva(!automacaoAtiva, 'alternarAutomacao (clique no painel)');
    if (automacaoAtiva) {
      log('Automação ligada pelo painel.');
      mostrarToast(NOME_SCRIPT + ': automação ligada.', 'rgba(20, 110, 60, 0.95)', 6000);
      proximoCicloPrevistoEm = Date.now() + 30000;
      setTimeout(cicloDePergunta, 30000);
    } else {
      log('Automação desligada pelo painel.');
      mostrarToast(NOME_SCRIPT + ': automação desligada.', 'rgba(150, 30, 30, 0.95)', 6000);
      clearTimeout(window.__sentinelaOnrTimer);
      proximoCicloPrevistoEm = null;
    }
  }

  // Botão flutuante de auditoria: mostra o histórico, permite ligar/desligar a
  // automação, e forçar o ciclo na hora (ignorando horário de expediente e o
  // agendamento normal, mas reagenda o próximo ciclo normal de 2h a partir de agora,
  // pra não rodar duas vezes seguidas). Forçar só funciona com a automação ligada.
  inicializarPainelAuditoria(() => {
    if (!automacaoAtiva) {
      mostrarToast(NOME_SCRIPT + ': ligue a automação antes de forçar a execução.', 'rgba(150, 30, 30, 0.95)', 8000);
      return;
    }
    log('Execução forçada manualmente pelo painel de auditoria.');
    mostrarToast(NOME_SCRIPT + ': execução forçada manualmente.', null, 6000);
    clearTimeout(window.__sentinelaOnrTimer);
    proximoCicloPrevistoEm = null;
    executarCicloCompleto().then(() => {
      agendarProximoCiclo(INTERVALO_CICLO_HORAS * 60 * 60 * 1000);
    });
  }, alternarAutomacao);

  // Só pra diagnóstico: loga quando a aba entra/sai de segundo plano, e o estado
  // de automacaoAtiva nesse momento — ajuda a ver se o Chrome throttlando a aba em
  // segundo plano tem relação com o problema relatado.
  document.addEventListener('visibilitychange', () => {
    console.log(
      '[Sentinela ONR][DEBUG] visibilitychange: document.hidden =', document.hidden,
      '| hora =', new Date().toLocaleTimeString('pt-BR'),
      '| automacaoAtiva =', automacaoAtiva,
      '| timer ativo =', !!window.__sentinelaOnrTimer
    );
  });

  log('Script ativo, mas automação DESLIGADA por padrão. Ligue pelo painel (canto inferior direito) quando quiser começar.');
  mostrarToast(NOME_SCRIPT + ' carregado — automação desligada. Ligue pelo painel.', null, 8000);
  pedirPermissaoNotificacao();
  console.log('[Sentinela ONR][DEBUG] Script inicializado. Digite __sentinelaOnrDebug() no console a qualquer momento pra ver o estado atual.');
})();